# --- database ---
DATABASE_URL="postgresql://taxta:taxta@localhost:5432/taxta_bozor?schema=public"

# --- api ---
PORT=8080
CORS_ORIGIN="http://localhost:5173"
JWT_SECRET="change-me-to-a-long-random-string"

# --- auth ---
# When AUTH_DEV_MODE=true and BOT_TOKEN is empty, /auth/telegram accepts { devUser }
# without HMAC validation. NEVER enable this in production.
AUTH_DEV_MODE=true
# Telegram initData is rejected if older than this many seconds (0 = no check).
TELEGRAM_AUTH_TTL=86400

# --- telegram bot (leave empty until you create one via BotFather) ---
BOT_TOKEN=
MINI_APP_URL="http://localhost:5173"

# --- seed ---
# This phone is seeded as an ACTIVE admin employee; the first Telegram/dev user who
# links it becomes ADMIN.
ADMIN_SEED_PHONE="+998901234567"

# --- exchange rate ---
CBU_RATE_URL="https://cbu.uz/uz/arkhiv-kursov-valyut/json/"
DEFAULT_USD_UZS=12800
